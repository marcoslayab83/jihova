# ============================================================
# CONFIGURACIÓN DE PRODUCCIÓN PARA EASYPANEL & CLOUDFLARE
# Copia y pega estos valores en la pestaña "Environment" de tu App en EasyPanel
# ============================================================

APP_NAME="JIHOVA"
APP_ENV=production
APP_KEY=base64:mhhxyCsG8VCxFY7L0FyW3jESQgZruIYc9nV23CwDN+8=
APP_DEBUG=false
APP_URL=https://jihova.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

# Registro de logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Conexión a Base de Datos (Servicio MySQL o MariaDB de EasyPanel)
DB_CONNECTION=mysql
DB_HOST=jihova-db
DB_PORT=3306
DB_DATABASE=jihova
DB_USERNAME=jihova
DB_PASSWORD=jihova_secure_password_2026

# Sesiones, Caché y Colas en Base de Datos
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Ejecutar automáticamente migraciones y seeders al desplegar
RUN_MIGRATIONS=true

# Seguridad
BCRYPT_ROUNDS=12
